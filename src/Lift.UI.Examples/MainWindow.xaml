<Window
    x:Class="Lift.UI.Examples.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Lift.UI.Examples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    Topmost="True"
    mc:Ignorable="d">
    <UniformGrid Columns="2" Rows="2">
        <Grid Background="{DynamicResource TextFillColorPrimaryBrush}" />
        <Grid Background="{DynamicResource TextFillColorSecondaryBrush}" />
        <Grid Background="{DynamicResource TextFillColorTertiaryBrush}" />
        <Grid Background="{DynamicResource TextFillColorDisabledBrush}" />
    </UniformGrid>
</Window>
