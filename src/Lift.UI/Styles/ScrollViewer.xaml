<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attach="clr-namespace:Lift.UI.Attach"
    xmlns:controls="clr-namespace:Lift.UI.Controls"
    xmlns:panel="clr-namespace:Lift.UI.Controls.Panel">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/Colors/Themes/Light.xaml" />
        <ResourceDictionary Source="../Resources/Constants.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  隐藏起来的上下部分  -->
    <Style x:Key="ScrollViewerStyle.RepeatButton.Base" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ScrollBar 两头的三角形  -->
    <Style x:Key="ScrollViewerStyle.RepeatButton.Line" TargetType="RepeatButton">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />

        <Setter Property="Width" Value="12" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Delay" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush.Secondary}" />
        <Setter Property="Interval" Value="100" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                To="0.9"
                                Duration="0:0:0" />
                            <DoubleAnimation
                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                To="0.9"
                                Duration="0:0:0" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                To="1"
                                Duration="0:0:0" />
                            <DoubleAnimation
                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                To="1"
                                Duration="0:0:0" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Drag Element  -->
    <Style x:Key="ScrollViewerStyle.Thumb.Vertical" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="attach:Element.Int32" Value="8" />
        <Setter Property="attach:Element.Double" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Width="{TemplateBinding Width}" Background="Transparent">
                        <Rectangle
                            x:Name="rectangle"
                            Width="{Binding Path=(attach:Element.Int32), RelativeSource={RelativeSource TemplatedParent}}"
                            Height="{TemplateBinding Height}"
                            HorizontalAlignment="Right"
                            Fill="{TemplateBinding Background}"
                            RadiusX="{Binding Path=(attach:Element.Double), RelativeSource={RelativeSource TemplatedParent}}"
                            RadiusY="{Binding Path=(attach:Element.Double), RelativeSource={RelativeSource TemplatedParent}}"
                            SnapsToDevicePixels="True">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform X="-2" />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="rectangle" Property="Fill" Value="{DynamicResource TextBrush.Secondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="rectangle" Property="Fill" Value="{DynamicResource TextBrush.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Drag Element  -->
    <Style x:Key="ScrollViewerStyle.Thumb.Horizontal" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="attach:Element.Int32" Value="8" />
        <Setter Property="attach:Element.Double" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Height="{TemplateBinding Height}" Background="Transparent">
                        <Rectangle
                            x:Name="rectangle"
                            Width="{TemplateBinding Width}"
                            Height="{Binding Path=(attach:Element.Int32), RelativeSource={RelativeSource TemplatedParent}}"
                            VerticalAlignment="Bottom"
                            Fill="{TemplateBinding Background}"
                            RadiusX="{Binding Path=(attach:Element.Double), RelativeSource={RelativeSource TemplatedParent}}"
                            RadiusY="{Binding Path=(attach:Element.Double), RelativeSource={RelativeSource TemplatedParent}}"
                            SnapsToDevicePixels="True">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform Y="-1" />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="rectangle" Property="Fill" Value="{DynamicResource TextBrush.Secondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="rectangle" Property="Fill" Value="{DynamicResource TextBrush.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollViewerStyle.ScrollBar.Vertical" TargetType="ScrollBar">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush.Secondary}" />
        <Setter Property="Background" Value="{DynamicResource ControlBrush.InputActive}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="4" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="SbMouseEnter" BeginTime="0:0:0.5">
                            <DoubleAnimation
                                Storyboard.TargetName="BoundingBox"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.1" />
                            <DoubleAnimation
                                Storyboard.TargetName="BtUp"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.1" />
                            <DoubleAnimation
                                Storyboard.TargetName="BtDown"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.1" />

                            <Int32AnimationUsingKeyFrames Storyboard.TargetName="TouchThumb" Storyboard.TargetProperty="(attach:Element.Int32)">
                                <EasingInt32KeyFrame KeyTime="0:0:.1" Value="8" />
                            </Int32AnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TouchThumb" Storyboard.TargetProperty="(attach:Element.Double)">
                                <EasingDoubleKeyFrame KeyTime="0:0:.2" Value="4" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TouchThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)">
                                <EasingDoubleKeyFrame KeyTime="0:0:.2" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                        <Storyboard x:Key="SbMouseLeave" BeginTime="0:0:0.5">
                            <DoubleAnimation
                                Storyboard.TargetName="BoundingBox"
                                Storyboard.TargetProperty="Opacity"
                                To="0.0"
                                Duration="0:0:0.1" />
                            <DoubleAnimation
                                Storyboard.TargetName="BtUp"
                                Storyboard.TargetProperty="Opacity"
                                To="0.0"
                                Duration="0:0:0.1" />
                            <DoubleAnimation
                                Storyboard.TargetName="BtDown"
                                Storyboard.TargetProperty="Opacity"
                                To="0.0"
                                Duration="0:0:0.1" />

                            <Int32AnimationUsingKeyFrames Storyboard.TargetName="TouchThumb" Storyboard.TargetProperty="(attach:Element.Int32)">
                                <EasingInt32KeyFrame KeyTime="0:0:.1" Value="2" />
                            </Int32AnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TouchThumb" Storyboard.TargetProperty="(attach:Element.Double)">
                                <EasingDoubleKeyFrame KeyTime="0:0:.2" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TouchThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)">
                                <EasingDoubleKeyFrame KeyTime="0:0:.2" Value="-1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid x:Name="Root">
                        <Grid.RowDefinitions>
                            <RowDefinition MaxHeight="14" />
                            <RowDefinition Height="0.00001*" />
                            <RowDefinition MaxHeight="14" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="BoundingBox"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Opacity="0" />
                        <RepeatButton
                            x:Name="BtUp"
                            Grid.Row="0"
                            Command="ScrollBar.LineUpCommand"
                            Opacity="0"
                            Style="{DynamicResource ScrollViewerStyle.RepeatButton.Line}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <controls:FontIcon
                                        FontSize="14"
                                        Foreground="{TemplateBinding Foreground}"
                                        Icon="CaretUp">
                                        <controls:FontIcon.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="-1" />
                                                <ScaleTransform CenterX="6" CenterY="6" ScaleX="1.3" ScaleY="1.3" />
                                            </TransformGroup>
                                        </controls:FontIcon.RenderTransform>
                                    </controls:FontIcon>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                        <Track
                            x:Name="PART_Track"
                            Grid.Row="1"
                            Margin="0,1"
                            attach:Element.Double="1"
                            attach:Element.Int32="2"
                            IsDirectionReversed="true"
                            IsEnabled="{TemplateBinding IsMouseOver}">

                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollViewerStyle.RepeatButton.Base}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollViewerStyle.RepeatButton.Base}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb
                                    x:Name="TouchThumb"
                                    attach:Element.Double="{Binding Path=(attach:Element.Double), RelativeSource={RelativeSource AncestorType=Track, AncestorLevel=1}}"
                                    attach:Element.Int32="{Binding Path=(attach:Element.Int32), RelativeSource={RelativeSource AncestorType=Track, AncestorLevel=1}}"
                                    Background="{TemplateBinding Foreground}"
                                    Style="{StaticResource ScrollViewerStyle.Thumb.Vertical}">
                                    <Thumb.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform X="-1" />
                                        </TransformGroup>
                                    </Thumb.RenderTransform>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <RepeatButton
                            x:Name="BtDown"
                            Grid.Row="2"
                            Command="ScrollBar.LineDownCommand"
                            Opacity="0"
                            Style="{DynamicResource ScrollViewerStyle.RepeatButton.Line}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <controls:FontIcon
                                        FontSize="14"
                                        Foreground="{TemplateBinding Foreground}"
                                        Icon="CaretDown">
                                        <controls:FontIcon.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="-1" />
                                                <ScaleTransform CenterX="6" CenterY="6" ScaleX="1.3" ScaleY="1.3" />
                                            </TransformGroup>
                                        </controls:FontIcon.RenderTransform>
                                    </controls:FontIcon>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource SbMouseEnter}" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard Storyboard="{StaticResource SbMouseLeave}" />
                        </EventTrigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

